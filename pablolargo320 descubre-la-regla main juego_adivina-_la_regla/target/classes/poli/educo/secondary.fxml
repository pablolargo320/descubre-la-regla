<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.educo.SecondaryController">

   <children>

      <Label text="Reglas del Juego: Adivina la Regla"
             style="-fx-font-size:18px; -fx-font-weight:bold;"/>

      <Label text="Objetivo:"
             style="-fx-font-weight:bold;"/>

      <Label text="Descubrir la regla que el sistema está utilizando para transformar números."
             wrapText="true"/>

      <Label text="Fase 1: Exploración"
             style="-fx-font-weight:bold;"/>

      <Label text="Ingresa números enteros en el campo de entrada. El sistema te devolverá un resultado basado en una regla oculta. Puedes probar cuantos números quieras para analizar el patrón."
             wrapText="true"/>

      <Label text="Cuando creas entender la regla, puedes continuar a la siguiente fase."
             wrapText="true"/>

      <Label text="Fase 2: Validación"
             style="-fx-font-weight:bold;"/>

      <Label text="El sistema te dará 4 números. Debes escribir la salida correcta para cada uno según la regla que descubriste."
             wrapText="true"/>

      <Label text="También puedes escribir directamente la regla si estás seguro."
             wrapText="true"/>

      <Label text="Intentos:"
             style="-fx-font-weight:bold;"/>

      <Label text="Solo tienes 3 intentos para acertar correctamente. Si fallas, perderás la partida."
             wrapText="true"/>

      <Label text="Condición de victoria:"
             style="-fx-font-weight:bold;"/>

      <Label text="Ganas si aciertas todas las salidas o si escribes correctamente la regla."
             wrapText="true"/>

      <Label text="Condición de derrota:"
             style="-fx-font-weight:bold;"/>

      <Label text="Pierdes si agotas todos los intentos sin acertar."
             wrapText="true"/>

      <Button text="Volver al menú"
              onAction="#switchToPrimary"/>

   </children>

   <padding>
      <Insets top="20" bottom="20" left="20" right="20"/>
   </padding>

</VBox>