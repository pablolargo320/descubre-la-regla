package poli.edu.co.vista;

import javafx.application.Application;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.stage.Stage;
import poli.edu.co.modelo.Partida;
import poli.edu.co.modelo.dao.ConexionBD;
import poli.edu.co.modelo.dao.JugadorDAO;
import poli.edu.co.modelo.dao.JugadorDAOImpl;

import java.io.IOException;
import java.util.logging.Logger;

/**
 * Punto de entrada de la aplicación JavaFX — raíz de composición (Composition Root).
 *
 * <h3>Responsabilidades</h3>
 * <ol>
 *   <li>Inicializar la base de datos (crear tablas si no existen).</li>
 *   <li>Instanciar el {@link JugadorDAO} y la {@link Partida} compartida
 *       (único lugar donde se crean estas dependencias).</li>
 *   <li>Cargar el CSS global y la escena principal.</li>
 *   <li>Proveer navegación entre pantallas mediante {@link #setRoot(String)}.</li>
 * </ol>
 *
 * <p>Los controladores acceden a la partida mediante {@link #getPartida()};
 * nunca crean su propia instancia de {@code Partida} ni del DAO.</p>
 */
public class App extends Application {

    private static final Logger LOG = Logger.getLogger(App.class.getName());

    /** Partida compartida entre todos los controladores. */
    private static Partida partida;

    /** Escena raíz de la ventana principal. */
    private static Scene scene;

    /**
     * Método de inicio de JavaFX. Inicializa la BD, crea la partida
     * compartida y muestra la pantalla de menú principal.
     *
     * @param stage escenario principal proporcionado por JavaFX.
     * @throws IOException si no se puede cargar el FXML inicial.
     */
    @Override
    public void start(Stage stage) throws IOException {
        try {
            ConexionBD.inicializarTablas();
        } catch (RuntimeException e) {
            LOG.warning("Base de datos no disponible: " + e.getMessage());
        }

        JugadorDAO dao = new JugadorDAOImpl();
        partida = new Partida(dao);

        scene = new Scene(loadFXML("primary"), 660, 520);
        scene.getStylesheets().add(
            App.class.getResource("/poli/edu/co/game-style.css").toExternalForm());

        stage.setTitle("Adivina la Regla");
        stage.setResizable(false);
        stage.setScene(scene);
        stage.show();
    }

    /**
     * Retorna la partida compartida entre todos los controladores.
     *
     * @return instancia única de {@link Partida} para la sesión actual.
     */
    public static Partida getPartida() { return partida; }

    /**
     * Navega a otra pantalla reemplazando la raíz de la escena.
     *
     * @param fxml nombre del archivo FXML (sin extensión) en
     *             {@code /poli/edu/co/}.
     * @throws IOException si el archivo FXML no puede cargarse.
     */
    public static void setRoot(String fxml) throws IOException {
        scene.setRoot(loadFXML(fxml));
    }

    private static Parent loadFXML(String fxml) throws IOException {
        FXMLLoader loader = new FXMLLoader(
            App.class.getResource("/poli/edu/co/" + fxml + ".fxml"));
        return loader.load();
    }

    /**
     * Método principal de arranque de la JVM.
     *
     * @param args argumentos de línea de comandos (no utilizados).
     */
    public static void main(String[] args) {
        launch();
    }
}
