<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.educo.JuegoController">

    <children>

        <Label text="Partida en curso"/>

        <Label fx:id="contadorLabel"
               text="Intentos: 0"/>

        <Label fx:id="mensajeLabel"
               text=""/>

        <Button text="Intentar"
                onAction="#realizarIntento"/>

        <Button text="Nueva Partida"
                onAction="#reiniciarPartida"/>

        <Button text="Volver al menú"
                onAction="#volverMenu"/>

    </children>

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

</VBox>