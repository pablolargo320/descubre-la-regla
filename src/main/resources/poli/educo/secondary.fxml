<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.educo.SecondaryController">

    <children>

        <Label text="Reglas del juego"/>

        <Label text="1. El objetivo es descubrir la regla secreta."/>
        <Label text="2. Cada intento cuenta en el contador."/>
        <Label text="3. Solo puedes hacer máximo 10 intentos."/>
        <Label text="4. El contador es visible durante la partida."/>
        <Label text="5. Puedes reiniciar la partida cuando quieras."/>

        <Button text="Volver"
                onAction="#switchToPrimary"/>

    </children>

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

</VBox>