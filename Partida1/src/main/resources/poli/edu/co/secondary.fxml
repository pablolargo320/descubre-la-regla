<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.edu.co.controlador.ReglasControlador"
      style="-fx-background-color: #1a2332;"
      prefWidth="660" prefHeight="520">

   <children>

      <Label text="Reglas del Juego"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f9a825;"/>

      <Label text="Objetivo:"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90caf9;"/>

      <Label text="Descubrir la regla que el sistema usa para transformar números enteros."
             wrapText="true" maxWidth="520"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

      <Label text="Fase 1 — Exploración:"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90caf9;"/>

      <Label text="Ingresa números enteros. El sistema te devuelve un resultado según una regla oculta. Prueba cuantos números quieras para analizar el patrón. Cuando creas entender la regla, pasa a la siguiente fase."
             wrapText="true" maxWidth="520"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

      <Label text="Fase 2 — Validación:"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90caf9;"/>

      <Label text="El sistema te dará 4 números. Escribe la salida correcta para cada uno. También puedes escribir la regla directamente si estás seguro."
             wrapText="true" maxWidth="520"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

      <Label text="Intentos:"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90caf9;"/>

      <Label text="Solo tienes 3 intentos. Si los agotas sin acertar, pierdes la partida."
             wrapText="true" maxWidth="520"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

      <Label text="Victoria: aciertas todas las salidas o escribes la regla correctamente."
             wrapText="true" maxWidth="520"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>

      <Button text="Volver al menú"
              onAction="#volverMenu"
              prefWidth="180"
              style="-fx-background-color: #1565c0; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 5;"/>

   </children>

   <padding>
      <Insets top="30" bottom="30" left="70" right="70"/>
   </padding>

</VBox>
