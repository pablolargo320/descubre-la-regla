<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.edu.co.controlador.NivelControlador"
      style="-fx-background-color: #1a2332;"
      prefWidth="660" prefHeight="520">

   <children>

      <Label text="Selecciona el Nivel"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f9a825;"/>

      <Label text="Elige la dificultad de la regla matemática"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

      <Button text="Fácil"
              onAction="#seleccionarFacil"
              prefWidth="220"
              style="-fx-background-color: #388e3c; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>

      <Button text="Intermedio"
              onAction="#seleccionarIntermedio"
              prefWidth="220"
              style="-fx-background-color: #1565c0; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>

      <Button text="Difícil"
              onAction="#seleccionarDificil"
              prefWidth="220"
              style="-fx-background-color: #f9a825; -fx-text-fill: #0d1117; -fx-font-family: 'Times New Roman'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>

      <Button text="Volver al menú"
              onAction="#volverMenu"
              prefWidth="160"
              style="-fx-background-color: #546e7a; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-padding: 7 14; -fx-background-radius: 5;"/>

   </children>

   <padding>
      <Insets top="60" bottom="60" left="80" right="80"/>
   </padding>

</VBox>
