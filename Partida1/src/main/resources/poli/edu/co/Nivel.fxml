<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="poli.edu.co.NivelController">
    <children>
        <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Selecciona el nivel de dificultad" />

        <Button onAction="#seleccionarFacil" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Fácil" />

        <Button onAction="#seleccionarIntermedio" prefWidth="200" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Intermedio" />

        <Button onAction="#seleccionarDificil" prefWidth="200" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Difícil" />

        <Button onAction="#volverMenu" text="Volver al menú" />
      <Accordion>
        <panes>
          <TitledPane animated="false" text="untitled 1">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </TitledPane>
          <TitledPane animated="false" text="untitled 2">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </TitledPane>
          <TitledPane animated="false" text="untitled 3">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </TitledPane>
        </panes>
      </Accordion>
    </children>
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>
</VBox>
