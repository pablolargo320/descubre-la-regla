<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.edu.co.controlador.JuegoControlador"
      style="-fx-background-color: #1a2332;"
      prefWidth="660" prefHeight="520">

   <children>

      <Label text="Adivina la Regla"
             style="-fx-font-family: 'Times New Roman'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f9a825;"/>

      <!-- ===== FASE 1: EXPLORACIÓN ===== -->
      <VBox fx:id="exploracionPane" alignment="CENTER" spacing="10"
            style="-fx-background-color: #263238; -fx-background-radius: 6; -fx-border-color: #546e7a; -fx-border-radius: 6; -fx-border-width: 1;">

         <children>

            <Label text="Fase 1 — Exploración"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64b5f6;"/>

            <Label text="Ingresa números enteros y observa la salida del sistema."
                   wrapText="true"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

            <HBox alignment="CENTER" spacing="10">
               <children>
                  <TextField fx:id="inputUsuario"
                             promptText="Número entero"
                             prefWidth="130"
                             style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>
                  <Button text="Probar"
                          onAction="#probarNumero"
                          prefWidth="100"
                          style="-fx-background-color: #f9a825; -fx-text-fill: #0d1117; -fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5;"/>
               </children>
            </HBox>

            <Label fx:id="outputSistema"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>

            <Label fx:id="mensajeExploracionLabel"
                   wrapText="true"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-font-style: italic; -fx-text-fill: #e8eaf6;"/>

            <Button fx:id="btnYaConozcoLaRegla"
                    text="Ya conozco la regla"
                    onAction="#yaConozcoLaRegla"
                    prefWidth="200"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 5;"/>

         </children>
         <padding>
            <Insets top="14" bottom="14" left="24" right="24"/>
         </padding>
      </VBox>

      <!-- ===== FASE 2: VALIDACIÓN ===== -->
      <VBox fx:id="validacionPane" alignment="CENTER" spacing="8"
            style="-fx-background-color: #263238; -fx-background-radius: 6; -fx-border-color: #546e7a; -fx-border-radius: 6; -fx-border-width: 1;">

         <children>

            <Label text="Fase 2 — Validación"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64b5f6;"/>

            <Label text="Escribe la salida para cada número, o la regla directamente."
                   wrapText="true"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

            <Label fx:id="intentosLabel"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90caf9;"/>

            <Label fx:id="mensajeValidacionLabel"
                   wrapText="true"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-font-style: italic; -fx-text-fill: #e8eaf6;"/>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n1Label"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f9a825; -fx-min-width: 35; -fx-alignment: center-right;"/>
                  <Label text="→"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>
                  <TextField fx:id="r1Field" prefWidth="75" promptText="Salida"
                             style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n2Label"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f9a825; -fx-min-width: 35; -fx-alignment: center-right;"/>
                  <Label text="→"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>
                  <TextField fx:id="r2Field" prefWidth="75" promptText="Salida"
                             style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n3Label"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f9a825; -fx-min-width: 35; -fx-alignment: center-right;"/>
                  <Label text="→"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>
                  <TextField fx:id="r3Field" prefWidth="75" promptText="Salida"
                             style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n4Label"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f9a825; -fx-min-width: 35; -fx-alignment: center-right;"/>
                  <Label text="→"
                         style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-text-fill: #eceff1;"/>
                  <TextField fx:id="r4Field" prefWidth="75" promptText="Salida"
                             style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>
               </children>
            </HBox>

            <Label text="O escribe la regla directamente (ej: x*2):"
                   style="-fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-text-fill: #b0bec5;"/>

            <TextField fx:id="reglaField"
                       promptText="x*2  /  x+5  /  x*3"
                       prefWidth="210"
                       style="-fx-background-color: #0d1117; -fx-text-fill: #eceff1; -fx-border-color: #546e7a; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-prompt-text-fill: #546e7a;"/>

            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Button text="Validar"
                          onAction="#validar"
                          prefWidth="130"
                          style="-fx-background-color: #2e7d32; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 5;"/>
                  <Button fx:id="btnVolverExplorar"
                          text="Volver a explorar"
                          onAction="#volverExplorar"
                          prefWidth="160"
                          style="-fx-background-color: #546e7a; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 12px; -fx-padding: 7 14; -fx-background-radius: 5;"/>
               </children>
            </HBox>

         </children>
         <padding>
            <Insets top="12" bottom="12" left="24" right="24"/>
         </padding>
      </VBox>

      <!-- ===== CONTROLES GLOBALES ===== -->
      <HBox alignment="CENTER" spacing="14">
         <children>
            <Button fx:id="btnNuevaPartida"
                    text="Nueva partida"
                    onAction="#nuevaPartida"
                    prefWidth="160"
                    style="-fx-background-color: #f9a825; -fx-text-fill: #0d1117; -fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5;"/>
            <Button fx:id="btnVolverMenu"
                    text="Volver al menú"
                    onAction="#volverMenu"
                    prefWidth="160"
                    style="-fx-background-color: #1565c0; -fx-text-fill: #eceff1; -fx-font-family: 'Times New Roman'; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 5;"/>
         </children>
      </HBox>

   </children>

   <padding>
      <Insets top="16" bottom="16" left="30" right="30"/>
   </padding>

</VBox>
