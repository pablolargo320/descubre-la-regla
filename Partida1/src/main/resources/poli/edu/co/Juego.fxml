<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="poli.edu.co.JuegoController">

    <children>

        <VBox fx:id="exploracionPane" alignment="CENTER" spacing="10">
            <children>

                <Label style="-fx-font-size:16px; -fx-font-weight:bold;" text="Fase 1: exploración" />

                <Label text="Ingresa números enteros y observa la salida del sistema." wrapText="true" />

                <TextField fx:id="inputUsuario" promptText="Número entero" />
                <Button onAction="#probarNumero" text="Probar" />

                <Label fx:id="outputSistema" />
                <Label fx:id="mensajeExploracionLabel" />

                <Button fx:id="btnYaConozcoLaRegla" onAction="#yaConozcoLaRegla" text="Ya conozco la regla" />

            </children>
        </VBox>

        <VBox fx:id="validacionPane" alignment="CENTER" spacing="10">
            <children>

                <Label style="-fx-font-size:16px; -fx-font-weight:bold;" text="Fase 2: validación" />

                <Label text="Con los 4 números que te da el sistema, escribe las 4 salidas correctas." wrapText="true" />

                <Label fx:id="intentosLabel" />
                <Label fx:id="mensajeValidacionLabel" />

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label fx:id="n1Label" />
                        <TextField fx:id="r1Field" prefWidth="60" promptText="Salida" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label fx:id="n2Label" />
                        <TextField fx:id="r2Field" prefWidth="60" promptText="Salida" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label fx:id="n3Label" />
                        <TextField fx:id="r3Field" prefWidth="60" promptText="Salida" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Label fx:id="n4Label" />
                        <TextField fx:id="r4Field" prefWidth="60" promptText="Salida" />
                    </children>
                </HBox>

                <Button onAction="#validar" text="Adivinar regla" />
                <Button fx:id="btnVolverExplorar" onAction="#volverExplorar" text="Volver a probar" />

            </children>
        </VBox>

        <Button fx:id="btnNuevaPartida" onAction="#nuevaPartida" text="Nueva partida" />
        <Button fx:id="btnVolverMenu" onAction="#volverMenu" text="Volver al menú" />

    </children>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</VBox>
