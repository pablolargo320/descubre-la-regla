<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.edu.co.NivelController">
    <children>
        <Label text="Selecciona el nivel de dificultad"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Button text="Fácil" prefWidth="200"
                onAction="#seleccionarFacil"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>

        <Button text="Intermedio" prefWidth="200"
                onAction="#seleccionarIntermedio"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>

        <Button text="Difícil" prefWidth="200"
                onAction="#seleccionarDificil"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>

        <Button text="Volver al menú" onAction="#volverMenu"/>
    </children>
    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>
</VBox>