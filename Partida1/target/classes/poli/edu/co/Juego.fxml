<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<VBox alignment="CENTER" spacing="14"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poli.edu.co.controlador.JuegoControlador"
      styleClass="pantalla"
      prefWidth="660" prefHeight="520">

   <children>

      <Label text="Adivina la Regla"
             styleClass="titulo-resultado"/>

      <!-- ═════════════════════════════════════════════
           FASE 1: EXPLORACIÓN
      ═════════════════════════════════════════════ -->
      <VBox fx:id="exploracionPane" alignment="CENTER" spacing="10"
            styleClass="card">

         <children>

            <Label text="Fase 1 — Exploración"
                   styleClass="titulo-fase"/>

            <Label fx:id="mensajeExploracionLabel"
                   wrapText="true"
                   styleClass="texto-hint"/>

            <!-- Fila de entrada y botón -->
            <HBox alignment="CENTER" spacing="10">
               <children>
                  <TextField fx:id="inputUsuario"
                             promptText="Número entero"
                             prefWidth="140"
                             styleClass="campo-texto"/>
                  <Button text="Probar"
                          onAction="#probarNumero"
                          prefWidth="110"
                          styleClass="btn-probar"/>
               </children>
            </HBox>

            <!-- Validación: campo no numérico (visible solo al haber error) -->
            <Label fx:id="errorInputLabel"
                   styleClass="msg-error"
                   visible="false" managed="false"/>

            <!-- Resultado de f(x) -->
            <Label fx:id="outputSistema"
                   styleClass="texto-salida"/>

            <Button fx:id="btnYaConozcoLaRegla"
                    text="Ya conozco la regla  →"
                    onAction="#yaConozcoLaRegla"
                    prefWidth="220"
                    styleClass="btn-oro"/>

         </children>
         <padding>
            <Insets top="16" bottom="16" left="28" right="28"/>
         </padding>
      </VBox>

      <!-- ═════════════════════════════════════════════
           FASE 2: VALIDACIÓN
      ═════════════════════════════════════════════ -->
      <VBox fx:id="validacionPane" alignment="CENTER" spacing="8"
            styleClass="card">

         <children>

            <Label text="Fase 2 — Validación"
                   styleClass="titulo-fase"/>

            <Label text="Escribe la salida para cada número, o la regla directamente."
                   wrapText="true"
                   styleClass="texto"/>

            <Label fx:id="intentosLabel"
                   styleClass="msg-intentos"/>

            <Label fx:id="mensajeValidacionLabel"
                   wrapText="true"
                   styleClass="msg-error"/>

            <!-- Pares número → respuesta -->
            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n1Label" styleClass="numero-reto"/>
                  <Label text="→" styleClass="flecha-reto"/>
                  <TextField fx:id="r1Field" prefWidth="80" promptText="Salida"
                             styleClass="campo-texto"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n2Label" styleClass="numero-reto"/>
                  <Label text="→" styleClass="flecha-reto"/>
                  <TextField fx:id="r2Field" prefWidth="80" promptText="Salida"
                             styleClass="campo-texto"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n3Label" styleClass="numero-reto"/>
                  <Label text="→" styleClass="flecha-reto"/>
                  <TextField fx:id="r3Field" prefWidth="80" promptText="Salida"
                             styleClass="campo-texto"/>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Label fx:id="n4Label" styleClass="numero-reto"/>
                  <Label text="→" styleClass="flecha-reto"/>
                  <TextField fx:id="r4Field" prefWidth="80" promptText="Salida"
                             styleClass="campo-texto"/>
               </children>
            </HBox>

            <Separator styleClass="separador"/>

            <Label text="O escribe la regla directamente (ej: x*2+5):"
                   styleClass="texto"/>

            <TextField fx:id="reglaField"
                       prefWidth="220"
                       promptText="Escribe la regla aquí"
                       styleClass="campo-texto"/>

            <HBox alignment="CENTER" spacing="12">
               <children>
                  <Button text="✔  Validar"
                          onAction="#validar"
                          prefWidth="140"
                          styleClass="btn-exito"/>
                  <Button fx:id="btnVolverExplorar"
                          text="← Volver a explorar"
                          onAction="#volverExplorar"
                          prefWidth="170"
                          styleClass="btn-neutro"/>
               </children>
            </HBox>

         </children>
         <padding>
            <Insets top="12" bottom="14" left="28" right="28"/>
         </padding>
      </VBox>

      <!-- ═════════════════════════════════════════════
           CONTROLES GLOBALES
      ═════════════════════════════════════════════ -->
      <HBox alignment="CENTER">
         <children>
            <Button fx:id="btnVolverMenu"
                    text="← Volver al menú"
                    onAction="#volverMenu"
                    prefWidth="190"
                    styleClass="btn-neutro"/>
         </children>
      </HBox>

   </children>

   <padding>
      <Insets top="16" bottom="16" left="30" right="30"/>
   </padding>

</VBox>
